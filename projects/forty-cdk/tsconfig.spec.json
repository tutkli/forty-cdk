/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"],
    "paths": {
      "forty-cdk": ["./src/public-api.ts"],
      "forty-cdk/button": ["./button/src/public-api.ts"],
      "forty-cdk/core": ["./core/src/public-api.ts"],
      "forty-cdk/dialog": ["./dialog/src/public-api.ts"],
      "forty-cdk/internationalized-date": ["./internationalized-date/src/public-api.ts"],
      "forty-cdk/virtualization": ["./virtualization/src/public-api.ts"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/test-utils/**/*.ts",
    "button/src/**/*.spec.ts",
    "core/src/**/*.spec.ts",
    "dialog/src/**/*.spec.ts",
    "virtualization/src/**/*.spec.ts"
  ]
}
