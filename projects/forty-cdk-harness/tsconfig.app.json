{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "paths": {
      "forty-cdk": ["../forty-cdk/src/public-api.ts"],
      "forty-cdk/button": ["../forty-cdk/button/src/public-api.ts"],
      "forty-cdk/core": ["../forty-cdk/core/src/public-api.ts"],
      "forty-cdk/dialog": ["../forty-cdk/dialog/src/public-api.ts"],
      "forty-cdk/virtualization": ["../forty-cdk/virtualization/src/public-api.ts"]
