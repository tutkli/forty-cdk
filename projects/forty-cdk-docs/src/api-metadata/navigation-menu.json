        },
        {
          "name": "ariaLabel",
          "kind": "input",
          "type": "string",
          "defaultValue": "''",
          "doc": "Optional accessible name for the surrounding `<nav>`."
        },
        {
          "name": "delayDuration",
          "kind": "input",
          "type": "number",
          "defaultValue": "this.#defaults.delayDuration",
          "doc": "ms before a hover/focus opens an item. Default `200`. The default is read from `provideForNavigationMenuDefaults` for the surrounding scope."
        },
        {
          "name": "closeDelay",
          "kind": "input",
          "type": "number",
          "defaultValue": "this.#defaults.closeDelay",
          "doc": "ms before an item closes after hover leaves. Default `150`. The default is read from `provideForNavigationMenuDefaults` for the surrounding scope."
        },
        {
          "name": "skipDelayDuration",
          "kind": "input",
          "type": "number",
          "defaultValue": "this.#defaults.skipDelayDuration",
          "doc": "ms after a peer item closed during which the next open is instant. Keeps fluid hover-across-triggers feeling responsive. Default `300`. The default is read from `provideForNavigationMenuDefaults` for the surrounding scope."
        }
      ],
      "outputs": [],
      "models": [
        {
          "name": "value",
          "kind": "model",
          "type": "string",
          "defaultValue": "''",
          "doc": "Two-way bindable. The id of the open item, or `''` for none. The `model()` change emitter (`(valueChange)`) fires only on internal transitions (trigger click, hover delay, Escape, outside click), never on consumer writes via `[(value)]`."
        }
