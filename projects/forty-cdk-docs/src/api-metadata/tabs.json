          "signature": "navigate(currentTrigger: HTMLElement, action: ListNavigationAction): void",
          "doc": ""
        },
        {
          "name": "registerTrigger",
          "signature": "registerTrigger(handle: ForTabsTriggerHandle): void",
          "doc": ""
        },
        {
          "name": "unregisterTrigger",
          "signature": "unregisterTrigger(handle: ForTabsTriggerHandle): void",
          "doc": ""
        },
        {
          "name": "registerContent",
          "signature": "registerContent(handle: ForTabsContentHandle): void",
          "doc": ""
        },
        {
          "name": "unregisterContent",
          "signature": "unregisterContent(handle: ForTabsContentHandle): void",
          "doc": ""
        },
        {
          "name": "triggerIdFor",
          "signature": "triggerIdFor(value: string): string | null",
          "doc": ""
        },
        {
          "name": "contentIdFor",
          "signature": "contentIdFor(value: string): string | null",
          "doc": ""
        },
        {
          "name": "isFirstEnabledTrigger",
          "signature": "isFirstEnabledTrigger(el: HTMLElement): boolean",
          "doc": ""
        }
      ]
    }
  ]
}
