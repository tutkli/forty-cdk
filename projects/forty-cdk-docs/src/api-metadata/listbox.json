      "selector": "[forListboxOptionIndicator]",
      "exportAs": "forListboxOptionIndicator",
      "host": {
        "[attr.data-state]": "parent.selected() ? \"checked\" : \"unchecked\"",
        "[attr.hidden]": "parent.selected() ? null : \"\""
