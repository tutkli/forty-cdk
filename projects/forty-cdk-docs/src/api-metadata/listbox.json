          "name": "unregisterLabel",
          "signature": "unregisterLabel(id: string): void",
          "doc": "Called by `ForListboxGroupLabel` on destroy. Idempotent."
        }
      ]
    },
    {
      "class": "ForListboxOptionIndicator",
