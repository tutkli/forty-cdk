        "[attr.aria-checked]": "checked() ? \"true\" : \"false\"",
        "[attr.aria-disabled]": "effectiveDisabled() ? \"true\" : null",
        "[attr.data-state]": "checked() ? \"checked\" : \"unchecked\"",
