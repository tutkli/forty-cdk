          "name": "value",
          "kind": "inputRequired",
          "type": "string",
          "defaultValue": null,
          "doc": "Identifier added to / read from the radio group's `value`. Required."
        },
        {
          "name": "disabled",
          "kind": "input",
          "type": "boolean",
          "defaultValue": "false",
          "doc": ""
        },
