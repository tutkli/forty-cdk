      "host": {
        "[attr.data-state]": "open() ? \"open\" : \"closed\"",
        "[attr.data-disabled]": "disabled() ? \"\" : null"
      },
      "doc": "Root for a nested submenu inside a parent `[forDropdownMenu]` / `[forContextMenu]` (or another `[forMenuSub]`). Owns its own open state, ids, and item collection — items inside the submenu register here, not in the parent.",
      "source": "menu/menu-sub.ts",
      "inputs": [
        {
          "name": "_dirInput",
          "kind": "input",
          "type": "WritingDirection | undefined",
          "defaultValue": "undefined",
          "doc": "Writing direction. When unset, inherits from the enclosing menu — set `[dir]` once on the top-level `[forDropdownMenu]` / `[forContextMenu]` and every nested submenu picks it up. Override per-submenu only when a specific submenu needs to render against the opposite direction."
        },
        {
          "name": "_sideInput",
          "kind": "input",
          "type": "FloatingSide | undefined",
          "defaultValue": "undefined",
          "doc": "Side the submenu opens on. When unset, defaults to `'right'` in LTR and `'left'` in RTL (per `dir`). Set explicitly to pin a side regardless of writing direction."
        },
        {
          "name": "align",
          "kind": "input",
          "type": "FloatingAlign | undefined",
          "defaultValue": "'start'",
          "doc": "Alignment along the chosen `side`. Defaults to `'start'`."
        },
        {
          "name": "sideOffset",
          "kind": "input",
          "type": "number",
          "defaultValue": "0",
          "doc": "Gap (px) along the main axis. Default `0`."
        },
        {
          "name": "alignOffset",
          "kind": "input",
          "type": "number",
          "defaultValue": "0",
          "doc": "Gap (px) along the cross axis. Default `0`."
        },
        {
          "name": "avoidCollisions",
          "kind": "input",
          "type": "boolean",
          "defaultValue": "true",
          "doc": "When `true` (default), `flip` and `shift` keep the submenu inside the viewport."
        },
        {
          "name": "collisionPadding",
          "kind": "input",
          "type": "number",
          "defaultValue": "8",
          "doc": "Padding (px) applied uniformly to flip / shift / size. Default `8`."
        },
        {
          "name": "arrowPadding",
          "kind": "input",
          "type": "number",
          "defaultValue": "0",
          "doc": "Padding (px) for the `arrow` middleware. Default `0`."
        },
        {
          "name": "sticky",
          "kind": "input",
          "type": "'partial' | 'always' | false",
          "defaultValue": "'partial'",
          "doc": "Stickiness behaviour for `shift`. Default `'partial'`."
