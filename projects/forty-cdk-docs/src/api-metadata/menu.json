        "(click)": "onClick()",
        "(keydown)": "onKeyDown($event)",
        "(focus)": "onFocus()",
        "(blur)": "onBlur()"
      },
      "doc": "A single action inside `[forMenuContent]`. Apply on a `<button>` so Space / Enter activation come from native button semantics.",
      "source": "menu/menu-item.ts",
      "inputs": [
        {
          "name": "disabled",
          "kind": "input",
          "type": "boolean",
          "defaultValue": "false",
          "doc": "Per-item disabled, in addition to the menu's `disabled`."
        },
        {
          "name": "textValue",
          "kind": "input",
          "type": "string",
          "defaultValue": "''",
          "doc": "Override the string used for typeahead matching. Defaults to `''`, which falls back to the item's `textContent`. Set this when the item DOM contains icons, kbd hints, or other text that shouldn't bleed into the match — e.g. `<button forMenuItem textValue=\"New file\">…</button>` for an item rendered as `New file ⌘N`."
        }
      ],
      "outputs": [
        {
          "name": "select",
          "kind": "output",
          "type": "VetoableEvent",
          "defaultValue": null,
          "doc": "Fires on click / Enter / Space activation. Call `preventDefault()` on the emitted veto to keep the menu open after activation."
        }
      ],
      "models": [],
      "methods": []
    },
