{
  "name": "forty-cdk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build forty-cdk",
    "watch": "ng build forty-cdk --watch --configuration development",
    "test": "ng test forty-cdk",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "docs:prebuild": "tsx projects/forty-cdk-docs/scripts/sync-readmes.ts && tsx projects/forty-cdk-docs/scripts/sync-example-sources.ts && tsx projects/forty-cdk-docs/scripts/generate-api-metadata.ts",
    "docs:dev": "pnpm docs:prebuild && vite --config projects/forty-cdk-docs/vite.config.ts",
    "docs:build": "pnpm docs:prebuild && vite build --config projects/forty-cdk-docs/vite.config.ts && pnpm docs:postbuild",
    "docs:postbuild": "tsx projects/forty-cdk-docs/scripts/generate-llms-txt.ts && pagefind --site dist/forty-cdk-docs --output-subdir _pagefind || echo \"[docs:postbuild] pagefind skipped (no prerendered HTML); resolve in Phase 5 — see vite.config.ts prerender notes\"",
    "docs:preview": "vite preview --config projects/forty-cdk-docs/vite.config.ts",
    "lint": "eslint .",
    "lint:rule-fixtures": "eslint --no-ignore projects/forty-cdk/eslint-rules-fixtures"
  },
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/content": "2.5.0",
    "@analogjs/platform": "2.5.0",
    "@analogjs/router": "2.5.0",
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-server": "^21.2.12",
    "@floating-ui/dom": "^1.7.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "angular-eslint": "^21.3.1",
    "eslint": "^10.3.0",
    "fast-glob": "^3.3.3",
    "front-matter": "^4.0.2",
    "jsdom": "^28.0.0",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-mangle": "^1.1.13",
    "ng-packagr": "^21.2.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.1",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.3.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.2",
    "vitest": "^4.0.8"
  }
}
