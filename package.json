{
  "name": "forty-cdk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "lefthook install || true",
    "start": "ng serve",
    "build": "ng build forty-cdk",
    "postbuild": "node scripts/check-emitted-types-compile.mjs && node scripts/check-entrypoint-registration.mjs && node scripts/check-entrypoint-dedup.mjs && node scripts/check-entrypoint-public-types.mjs && node scripts/check-readonly-contexts.mjs && node scripts/check-registration-surfaces.mjs && node scripts/check-context-surfaces.mjs && node scripts/check-alias-input-surface.mjs && node scripts/check-convention-matrices.mjs && node scripts/check-docs-coverage.mjs && node scripts/check-third-party-names.mjs && node scripts/check-fesm-size-budget.mjs",
    "check:dedup": "node scripts/check-entrypoint-dedup.mjs",
    "check:emitted-types": "node scripts/check-emitted-types-compile.mjs",
    "check:public-types": "node scripts/check-entrypoint-public-types.mjs",
    "check:readonly-contexts": "node scripts/check-readonly-contexts.mjs",
    "check:registration": "node scripts/check-entrypoint-registration.mjs",
    "check:registration-surfaces": "node scripts/check-registration-surfaces.mjs",
    "check:context-surfaces": "node scripts/check-context-surfaces.mjs",
    "check:alias-input-surface": "node scripts/check-alias-input-surface.mjs",
    "check:matrices": "node scripts/check-convention-matrices.mjs",
    "check:docs-coverage": "node scripts/check-docs-coverage.mjs",
    "check:third-party-names": "node scripts/check-third-party-names.mjs",
    "check:fesm-size": "node scripts/check-fesm-size-budget.mjs",
    "measure:comment-density": "node scripts/measure-comment-density.mjs",
    "watch": "ng build forty-cdk --watch --configuration development",
    "gen:example-sources": "node scripts/gen-example-sources.mjs",
    "gen:doc-model": "node scripts/docs/gen-doc-model.mjs",
    "gen:docs-data": "pnpm gen:example-sources && pnpm gen:doc-model",
    "docs": "pnpm gen:docs-data && ng serve forty-cdk-docs",
    "build:docs:dev": "pnpm gen:docs-data && ng build forty-cdk-docs --configuration development",
    "build:docs": "pnpm gen:docs-data && pnpm check:doc-links && ng build forty-cdk-docs --configuration production && pnpm gen:llms && pnpm check:prerender && pnpm check:llms && pnpm check:doc-output",
    "gen:llms": "node scripts/gen-llms-txt.mjs",
    "check:prerender": "node scripts/check-prerender-output.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:llms": "node scripts/check-llms-output.mjs",
    "check:doc-output": "node scripts/check-doc-output.mjs",
    "check:doc-snippets": "node scripts/check-doc-snippets.mjs",
    "check:hero-fences": "node scripts/check-hero-fences.mjs",
    "gen:hero-fences": "node scripts/check-hero-fences.mjs --write",
    "check:doc-prose": "node scripts/check-doc-prose.mjs",
    "test": "ng test forty-cdk",
    "test:docs": "pnpm gen:docs-data && pnpm check:doc-snippets && pnpm check:hero-fences && pnpm check:doc-prose && ng test forty-cdk-docs",
    "test:watch": "ng test forty-cdk --watch",
    "test:coverage": "node scripts/run-coverage.mjs",
    "typecheck": "pnpm typecheck:lib && pnpm typecheck:apps",
    "typecheck:lib": "pnpm check:registration && tsc -p projects/forty-cdk/tsconfig.lib.json --noEmit && tsc -p projects/forty-cdk/tsconfig.spec.json --noEmit",
    "typecheck:apps": "pnpm typecheck:harness && pnpm typecheck:e2e && pnpm typecheck:docs",
    "typecheck:harness": "tsc -p projects/forty-cdk-harness/tsconfig.typecheck.json --noEmit",
    "typecheck:e2e": "tsc -p projects/forty-cdk-harness/tsconfig.e2e.json --noEmit",
    "typecheck:docs": "pnpm gen:docs-data && tsc -p projects/forty-cdk-docs/tsconfig.typecheck.json --noEmit && tsc -p projects/forty-cdk-docs/tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "lint": "eslint .",
    "lint:rule-fixtures": "eslint --no-ignore projects/forty-cdk/eslint-rules-fixtures"
  },
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@internationalized/date": "^3.12.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/virtual-core": "^3.19.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.2",
    "marked": "^18.1.1",
    "ng-packagr": "^22.2.4",
    "prettier": "3.9.10",
    "rxjs": "~7.8.0",
    "shiki": "^4.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
