{
  "name": "forty-cdk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "lefthook install || true",
    "start": "ng serve",
    "build": "ng build forty-cdk",
    "postbuild": "node scripts/strip-fesm-comments.mjs && node scripts/check-emitted-types-compile.mjs && node scripts/check-entrypoint-registration.mjs && node scripts/check-entrypoint-dedup.mjs && node scripts/check-entrypoint-public-types.mjs && node scripts/check-readonly-contexts.mjs && node scripts/check-registration-surfaces.mjs && node scripts/check-context-surfaces.mjs && node scripts/check-alias-input-surface.mjs && node scripts/check-convention-matrices.mjs && node scripts/check-fesm-size-budget.mjs",
    "check:dedup": "node scripts/check-entrypoint-dedup.mjs",
    "check:emitted-types": "node scripts/check-emitted-types-compile.mjs",
    "check:public-types": "node scripts/check-entrypoint-public-types.mjs",
    "check:readonly-contexts": "node scripts/check-readonly-contexts.mjs",
    "check:registration": "node scripts/check-entrypoint-registration.mjs",
    "check:registration-surfaces": "node scripts/check-registration-surfaces.mjs",
    "check:context-surfaces": "node scripts/check-context-surfaces.mjs",
    "check:alias-input-surface": "node scripts/check-alias-input-surface.mjs",
    "check:matrices": "node scripts/check-convention-matrices.mjs",
    "check:fesm-size": "node scripts/check-fesm-size-budget.mjs",
    "strip:fesm-comments": "node scripts/strip-fesm-comments.mjs",
    "watch": "ng build forty-cdk --watch --configuration development",
    "gen:example-sources": "node scripts/gen-example-sources.mjs",
    "gen:search-index": "node scripts/gen-search-index.mjs",
    "gen:playground-data": "pnpm gen:example-sources && pnpm gen:search-index",
    "playground": "pnpm gen:playground-data && ng serve forty-cdk-playground",
    "build:playground": "pnpm gen:playground-data && ng build forty-cdk-playground --configuration development",
    "build:docs": "pnpm gen:playground-data && ng build forty-cdk-playground --configuration production && pnpm check:prerender",
    "check:prerender": "node scripts/check-prerender-output.mjs",
    "test": "ng test forty-cdk",
    "test:watch": "ng test forty-cdk --watch",
    "test:coverage": "node scripts/run-coverage.mjs",
    "typecheck": "pnpm typecheck:lib && pnpm typecheck:apps",
    "typecheck:lib": "pnpm check:registration && tsc -p projects/forty-cdk/tsconfig.lib.json --noEmit && tsc -p projects/forty-cdk/tsconfig.spec.json --noEmit",
    "typecheck:apps": "pnpm typecheck:harness && pnpm typecheck:e2e && pnpm typecheck:playground",
    "typecheck:harness": "tsc -p projects/forty-cdk-harness/tsconfig.typecheck.json --noEmit",
    "typecheck:e2e": "tsc -p projects/forty-cdk-harness/tsconfig.e2e.json --noEmit",
    "typecheck:playground": "pnpm gen:playground-data && tsc -p projects/forty-cdk-playground/tsconfig.typecheck.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "lint": "eslint .",
    "lint:rule-fixtures": "eslint --no-ignore projects/forty-cdk/eslint-rules-fixtures"
  },
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@internationalized/date": "^3.12.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/platform-server": "^22.0.4",
    "@angular/ssr": "^22.0.4",
    "@floating-ui/dom": "^1.7.6",
    "@playwright/test": "^1.60.0",
    "@tanstack/virtual-core": "^3.17.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "lefthook": "^2.1.9",
    "marked": "^18.0.5",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "shiki": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
