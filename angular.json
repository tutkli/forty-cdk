{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "forty-cdk": {
      "projectType": "library",
      "root": "projects/forty-cdk",
      "sourceRoot": "projects/forty-cdk/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/forty-cdk/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/forty-cdk/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/forty-cdk/tsconfig.spec.json",
            "runnerConfig": true,
            "setupFiles": ["projects/forty-cdk/src/test-utils/vitest-invariants-setup.ts"],
            "include": [
              "**/*.spec.ts",
              "../core/src/**/*.spec.ts",
              "../button/src/**/*.spec.ts",
              "../dialog/src/**/*.spec.ts",
              "../virtualization/src/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "forty-cdk-harness": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "inlineStyle": true,
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/forty-cdk-harness",
      "sourceRoot": "projects/forty-cdk-harness/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/forty-cdk-harness/src/main.ts",
            "tsConfig": "projects/forty-cdk-harness/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/forty-cdk-harness/public"
              }
            ],
            "styles": ["projects/forty-cdk-harness/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "forty-cdk-harness:build:production"
            },
            "development": {
              "buildTarget": "forty-cdk-harness:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "forty-cdk-playground": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "inlineStyle": true,
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/forty-cdk-playground",
      "sourceRoot": "projects/forty-cdk-playground/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/forty-cdk-playground/src/main.ts",
            "tsConfig": "projects/forty-cdk-playground/tsconfig.app.json",
            "styles": ["projects/forty-cdk-playground/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "forty-cdk-playground:build:production"
            },
            "development": {
              "buildTarget": "forty-cdk-playground:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
